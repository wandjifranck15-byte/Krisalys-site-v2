# URL publique du site (utilisée pour le SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.krisalysglobal.com

# Numéro WhatsApp au format international sans le +
NEXT_PUBLIC_WHATSAPP_NUMBER=237682909162

# Clé API pour l'envoi d'emails depuis le formulaire de contact (ex: Resend)
# À renseigner en production - voir README section "Formulaire de contact"
RESEND_API_KEY=
CONTACT_EMAIL_TO=your-email@example.com

# Jeton d'application privée HubSpot (scopes minimum : crm.objects.contacts.write,
# crm.objects.companies.write, crm.objects.deals.write).
# Optionnel : tant que cette variable est vide, la synchronisation CRM est
# simplement ignorée et le formulaire continue de fonctionner via Resend.
HUBSPOT_ACCESS_TOKEN=

# IDs internes HubSpot (PAS les libellés visibles) du pipeline commercial et
# de l'étape "Nouveau Prospect" — voir Paramètres > Objets > Transactions >
# Pipelines dans HubSpot. Optionnels : sans eux, la transaction est créée dans
# le pipeline par défaut du compte.
HUBSPOT_DEAL_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_NEW=
